
from collections import deque
from itertools import permutations

# Cost matrix
graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

n = len(graph)
queue = deque([(0, [0], 0)])
min_cost = float('inf')
best_path = []

while queue:
    city, path, cost = queue.popleft()

    if len(path) == n:
        total = cost + graph[city][0]

        if total < min_cost:
            min_cost = total
            best_path = path + [0]
    else:
        for next_city in range(n):
            if next_city not in path:
                queue.append((
                    next_city,
                    path + [next_city],
                    cost + graph[city][next_city]
                ))

print("Minimum Cost:", min_cost)
print("Best Path:", " -> ".join(map(str, best_path)))
