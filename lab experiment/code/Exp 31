
import math

x = [[1, 2], [2, 3], [3, 4], [6, 7], [7, 8]]
y = [0, 0, 0, 1, 1]

test = [2, 4]
distances = []

for i in range(len(x)):
    d = math.sqrt((x[i][0]-test[0])**2 +
                  (x[i][1]-test[1])**2)
    distances.append((d, y[i]))

distances.sort()

neighbors = [item[1] for item in distances[:3]]

result = max(set(neighbors), key=neighbors.count)

print("Predicted Class:", result)
