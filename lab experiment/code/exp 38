
data = [[1, 2], [2, 3], [3, 4],
        [8, 9], [9, 10], [10, 11]]

centers = [[1, 2], [8, 9]]

for i in range(5):
    clusters = [[], []]

    for point in data:
        d1 = sum((a-b)**2 for a, b in zip(point, centers[0]))
        d2 = sum((a-b)**2 for a, b in zip(point, centers[1]))

        clusters[0 if d1 < d2 else 1].append(point)

    for j in range(2):
        centers[j] = [
            sum(p[k] for p in clusters[j]) / len(clusters[j])
            for k in range(2)
        ]

print("Cluster 1:", clusters[0])
print("Cluster 2:", clusters[1])
print("Cluster Centers:", centers)
