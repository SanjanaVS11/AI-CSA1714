from collections import deque

def water_jug(cap1, cap2, target):
    queue = deque([((0, 0), [])])
    visited = set()

    while queue:
        (x, y), path = queue.popleft()

        if (x, y) in visited:
            continue

        visited.add((x, y))
        path = path + [(x, y)]

        if x == target or y == target:
            print("Solution:")
            for state in path:
                print(state)
            return

        states = [
            (cap1, y),                  # Fill Jug 1
            (x, cap2),                  # Fill Jug 2
            (0, y),                     # Empty Jug 1
            (x, 0),                     # Empty Jug 2
            (max(0, x-(cap2-y)), min(cap2, x+y)),  # Jug 1 -> Jug 2
            (min(cap1, x+y), max(0, y-(cap1-x)))   # Jug 2 -> Jug 1
        ]

        for state in states:
            if state not in visited:
                queue.append((state, path))


# Jug capacities: 4 litres and 3 litres
# Target: 2 litres
water_jug(4, 3, 2)
