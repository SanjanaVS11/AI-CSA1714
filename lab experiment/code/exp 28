:- use_module(library(pairs)).

edge(a, b).
edge(a, c).
edge(b, d).
edge(b, e).
edge(c, f).
edge(c, g).

heuristic(a, 6).
heuristic(b, 4).
heuristic(c, 3).
heuristic(d, 5).
heuristic(e, 2).
heuristic(f, 1).
heuristic(g, 0).

best_first(Start, Goal, Path) :-
    search([[Start]], Goal, RevPath),
    reverse(RevPath, Path).

search([[Goal|Rest]|_], Goal, [Goal|Rest]).

search([Path|Paths], Goal, Result) :-
    Path = [Node|_],
    findall([Next|Path],
            (edge(Node, Next),
             \+ member(Next, Path)),
            NewPaths),
    append(Paths, NewPaths, AllPaths),
    map_list_to_pairs(path_h, AllPaths, Pairs),
    keysort(Pairs, Sorted),
    pairs_values(Sorted, SortedPaths),
    search(SortedPaths, Goal, Result).

path_h([Node|_], H) :-
    heuristic(Node, H).
